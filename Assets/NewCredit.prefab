      m_Calls: []
  m_text: '<size=150%><color=#FFFFFF><b>- SPECIAL THANKS -</b></color></size>

    \n


    <size=110%><color=#99FF99>THE
    LAPTOP</color></size>


    <size=80%><color=#777777><i>The only one who truly
    stayed awake.</i></color></size>

    \n\n


    <size=110%><color=#6666FF>The
    Night</color></size>


    <size=80%><color=#777777><i>Where snack became the
    engine of life.</i></color></size>

    \n\n


    <size=110%><color=#FFCC99>Left
    and Right Hands</color></size>


    <size=80%><color=#777777><i>The only executors
    who never complained.</i></color></size>

    \n\n

    <size=100%><color=#AAAAAA>And
    finally, to</color></size>


    <size=180%><color=#FF1744><b> <i>            
    You</b></color></size>


    <size=80%><color=#777777><i>For witnessing this
    echo in the dark.</i></color></size>


    </line-height></align>'
