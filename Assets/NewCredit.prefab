  m_text: "\r\n<size=80%><color=#777777>A creation by</color></size>\r\n\\n\r\n\r\n<size=110%><color=#FFB300>Core
    Programmer/</color></size> <size=140%><color=#FFFFFF><b>        Low Wen Jun</b></color></size>\n\r\n<size=70%><color=#666666><i>###
    He defined the \"Zero\" ###</i></color></size> \r\n\\n\\n\r\n\r\n<size=110%><color=#E91E63>Gameplay
    Programmer/</color></size> <size=140%><color=#FFFFFF><b>Lam Ming Kang</b></color></size>\n\r\n<size=70%><color=#666666><i>###
    He shaped the \"Wait\" ###</i></color></size>\r\n\\n\\n\r\n\r\n<size=110%><color=#00BCD4>Technical
    Artist /</color></size> <size=140%><color=#FFFFFF><b>         Wong Kar Ming</b></color></size>\n\r\n<size=70%><color=#666666><i>###
    He captured the \"Sight\" ###</i></color></size>\r\n\\n\\n\r\n\r\n<size=110%><color=#F44336>Audio
    Engineer /</color></size> <size=140%><color=#FFFFFF><b>           Lai Yao Xuan</b></color></size>\n\r\n<size=70%><color=#666666><i>###
    He found the \"Silence\" ###</i></color></size>\r\n\\n\\n\\n\r\n\r\n\r\n"
